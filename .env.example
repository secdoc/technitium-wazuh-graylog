# Technitium DNS -> SIEM: environment variables (copy to .env, fill in)
# NEVER commit a real .env. Placeholders only.

# --- Technitium DNS (read-only Query Logs API) ---
# Comma-separated host or host:port (default port 5380). One or many servers.
TECHNITIUM_SERVERS=dns1.example.local,dns2.example.local
TECHNITIUM_TOKEN=CHANGE_ME

# --- Graylog (GELF/TCP input) ---
GRAYLOG_HOST=graylog.example.local

# --- Wazuh manager (SSH append to a json localfile) ---
WAZUH_SSH_HOST=wazuh.example.local
WAZUH_SSH_USER=svc-collector
WAZUH_SSH_KEY=/path/to/ssh_key
